# EggMint Plymouth theme - pixel Eierbaer with a mustache loading bar.
# Pure Plymouth script: no compiled code. If anything here fails, Plymouth
# simply falls back to its text splash and the system boots normally.

Window.SetBackgroundTopColor(0.33, 0.58, 0.86);
Window.SetBackgroundBottomColor(0.74, 0.87, 0.98);

sw = Window.GetWidth();
sh = Window.GetHeight();
ox = Window.GetX();
oy = Window.GetY();

mode = Plymouth.GetMode();

# ------------------------------------------------------------- images
portrait_img = Image("portrait.png");
title_img = Image("title.png");

if (mode == "shutdown")
  sub_img = Image("subtitle-shutdown.png");
else if (mode == "reboot")
  sub_img = Image("subtitle-reboot.png");
else if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade")
  sub_img = Image("subtitle-updates.png");
else
  sub_img = Image("subtitle-boot.png");

STEPS = 24;
for (i = 0; i <= STEPS; i++)
  {
    stache[i * 3 + 0] = Image("stache-" + i + "-0.png");
    stache[i * 3 + 1] = Image("stache-" + i + "-1.png");
    stache[i * 3 + 2] = Image("stache-" + i + "-2.png");
  }

# ------------------------------------------------------------- layout
pw = portrait_img.GetWidth();
ph = portrait_img.GetHeight();
stw = stache[0].GetWidth();
sth = stache[0].GetHeight();
tw = title_img.GetWidth();
th = title_img.GetHeight();

block_h = th + 24 + ph + 24 + sth + 20 + sub_img.GetHeight();
top = oy + Math.Int((sh - block_h) / 2);
if (top < oy) top = oy;

title_sprite = Sprite(title_img);
title_sprite.SetPosition(ox + Math.Int((sw - tw) / 2), top, 10);

portrait_y = top + th + 24;
portrait_x = ox + Math.Int((sw - pw) / 2);
portrait_sprite = Sprite(portrait_img);
portrait_sprite.SetPosition(portrait_x, portrait_y, 10);

# little mustache on the Eierbaer's face (offset from face-offset.txt)
FACE_OX = 132;
FACE_OY = 186;
face[0] = Image("face-0.png");
face[1] = Image("face-1.png");
face[2] = Image("face-2.png");
face_sprite = Sprite(face[0]);
face_sprite.SetPosition(portrait_x + FACE_OX, portrait_y + FACE_OY, 11);

stache_y = portrait_y + ph + 24;
stache_sprite = Sprite(stache[0]);
stache_sprite.SetPosition(ox + Math.Int((sw - stw) / 2), stache_y, 10);

sub_y = stache_y + sth + 20;
sub_sprite = Sprite(sub_img);
sub_sprite.SetPosition(ox + Math.Int((sw - sub_img.GetWidth()) / 2), sub_y, 10);

# ------------------------------------------------------------- animation
tick = 0;
real_progress = 0;
shown = 0;

fun boot_progress_cb(duration, progress)
  {
    if (progress > real_progress)
      real_progress = progress;
  }
Plymouth.SetBootProgressFunction(boot_progress_cb);

fun refresh_cb()
  {
    tick++;

    if (mode == "boot")
      {
        # slow time-based fallback so the bar never looks stuck (first boot)
        fake = tick / (50 * 16);
        if (fake > 0.6) fake = 0.6;
        target = real_progress;
        if (fake > target) target = fake;
      }
    else
      {
        # shutdown / reboot / updates: no progress info, loop the fill
        target = (tick % 150) / 150;
        shown = target;
      }

    if (target > shown) shown = shown + (target - shown) * 0.08;
    if (shown > 1) shown = 1;

    step = Math.Int(shown * STEPS + 0.5);
    if (step > STEPS) step = STEPS;
    if (step < 0) step = 0;

    # mustache twitch: 0 -> up -> 0 -> down
    phase = Math.Int(tick / 9) % 4;
    if (phase == 1) wig = 1;
    else if (phase == 3) wig = 2;
    else wig = 0;

    stache_sprite.SetImage(stache[step * 3 + wig]);
    face_sprite.SetImage(face[wig]);

    # gentle pixel bob of the Eierbaer (whole pixels only)
    bob = Math.Int(Math.Sin(tick / 12) * 2.5) * 2;
    portrait_sprite.SetY(portrait_y + bob);
    face_sprite.SetY(portrait_y + FACE_OY + bob);
  }
Plymouth.SetRefreshFunction(refresh_cb);

# ------------------------------------------------------------- password / questions
pw_label_img = Image("password.png");
entry_img = Image("entry.png");
bullet_img = Image("bullet.png");

pw_label = Sprite(pw_label_img);
pw_label.SetOpacity(0);
entry_sprite = Sprite(entry_img);
entry_sprite.SetOpacity(0);
prompt_sprite = Sprite();
answer_sprite = Sprite();
for (i = 0; i < 24; i++)
  {
    bullets[i] = Sprite(bullet_img);
    bullets[i].SetOpacity(0);
  }

# "PASSWORD:" label and the entry box sit on one row where the subtitle was
row_w = pw_label_img.GetWidth() + 14 + entry_img.GetWidth();
row_x = ox + Math.Int((sw - row_w) / 2);
entry_x = row_x + pw_label_img.GetWidth() + 14;
entry_y = sub_y;
pw_label.SetPosition(row_x, entry_y + Math.Int((entry_img.GetHeight() - pw_label_img.GetHeight()) / 2), 20);
entry_sprite.SetPosition(entry_x, entry_y, 20);

fun hide_dialog()
  {
    pw_label.SetOpacity(0);
    entry_sprite.SetOpacity(0);
    prompt_sprite.SetOpacity(0);
    answer_sprite.SetOpacity(0);
    for (i = 0; i < 24; i++)
      bullets[i].SetOpacity(0);
    sub_sprite.SetOpacity(1);
  }

fun display_normal_cb()
  {
    hide_dialog();
  }

fun display_password_cb(prompt, count)
  {
    sub_sprite.SetOpacity(0);
    pw_label.SetOpacity(1);
    entry_sprite.SetOpacity(1);
    prompt_img = Image.Text(prompt, 1, 0.96, 0.87, 1);
    prompt_sprite.SetImage(prompt_img);
    prompt_sprite.SetPosition(ox + Math.Int((sw - prompt_img.GetWidth()) / 2), entry_y + entry_img.GetHeight() + 12, 20);
    prompt_sprite.SetOpacity(1);
    bw = bullet_img.GetWidth() + 4;
    for (i = 0; i < 24; i++)
      {
        if (i < count)
          {
            bullets[i].SetPosition(entry_x + 12 + i * bw, entry_y + Math.Int((entry_img.GetHeight() - bullet_img.GetHeight()) / 2), 21);
            bullets[i].SetOpacity(1);
          }
        else
          bullets[i].SetOpacity(0);
      }
  }

fun display_question_cb(prompt, entry)
  {
    sub_sprite.SetOpacity(0);
    entry_sprite.SetOpacity(1);
    prompt_img = Image.Text(prompt, 1, 0.96, 0.87, 1);
    prompt_sprite.SetImage(prompt_img);
    prompt_sprite.SetPosition(ox + Math.Int((sw - prompt_img.GetWidth()) / 2), entry_y + entry_img.GetHeight() + 12, 20);
    prompt_sprite.SetOpacity(1);
    answer_img = Image.Text(entry, 1, 0.96, 0.87, 1);
    answer_sprite.SetImage(answer_img);
    answer_sprite.SetPosition(entry_x + 12, entry_y + Math.Int((entry_img.GetHeight() - answer_img.GetHeight()) / 2), 21);
    answer_sprite.SetOpacity(1);
  }

Plymouth.SetDisplayNormalFunction(display_normal_cb);
Plymouth.SetDisplayPasswordFunction(display_password_cb);
Plymouth.SetDisplayQuestionFunction(display_question_cb);

# ------------------------------------------------------------- messages
message_sprite = Sprite();
fun message_cb(text)
  {
    msg_img = Image.Text(text, 1, 0.96, 0.87, 1);
    message_sprite.SetImage(msg_img);
    message_sprite.SetPosition(ox + Math.Int((sw - msg_img.GetWidth()) / 2), oy + sh - msg_img.GetHeight() - 20, 30);
  }
Plymouth.SetMessageFunction(message_cb);

fun quit_cb()
  {
    stache_sprite.SetImage(stache[STEPS * 3]);
  }
Plymouth.SetQuitFunction(quit_cb);
